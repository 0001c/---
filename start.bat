@echo off
:: 设置控制台为 UTF-8 编码，防止中文出现乱码
chcp 65001 >nul

echo ===========================================
echo       欢迎使用 调剂规划自动化生成工具
echo ===========================================
echo.

:: 第一步：尝试激活虚拟环境
if exist ".venv\Scripts\activate.bat" (
    echo [检查] 找到虚拟环境，正在激活...
    call .venv\Scripts\activate.bat
) else (
    echo [警告] 未找到 .venv 虚拟环境！将尝试使用系统全局 Python 运行。
)

:: 第二步：检查必要的数据文件是否存在
echo [检查] 正在验证基础文件...

if not exist "模板.xlsx" (
    echo ❌ [错误] 找不到 "模板.xlsx"！
    echo 请确保 "模板.xlsx" 文件与本脚本放在同一个文件夹内。
    goto :end
)

if not exist "统计表.xlsx" (
    echo ❌ [错误] 找不到 "统计表.xlsx"！
    echo 请确保从问卷导出的 "统计表.xlsx" 文件与本脚本放在同一个文件夹内。
    goto :end
)

echo ✅ [成功] 模板和统计表文件均已就绪！
echo.

:: 第三步：运行主程序
echo ===========================================
echo             开始执行核心程序...
echo ===========================================
python edit.py

:end
echo.
echo ===========================================
echo                 运行结束
echo ===========================================
:: 暂停窗口，防止程序运行完或报错后瞬间闪退，让用户能看清屏幕上的提示
pause